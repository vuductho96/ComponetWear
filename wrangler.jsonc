{
  "name": "componetlife",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": "./.cloud-publish/assets",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "cloud/worker.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "componetlife-db",
      "database_id": "1b7d67df-00d3-4925-9ea7-4b8ec362d7de",
      "migrations_dir": "cloud/migrations"
    }
  ]
}
